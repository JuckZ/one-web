{
  "name": "one-web",
  "displayName": "OneWeb",
  "version": "0.1.0",
  "private": true,
  "description": "你的浏览器伴侣：把搜索、整理、浏览器工具与智能分析集中到一个侧边工作台。",
  "homepage": "https://github.com/JuckZ/one-web",
  "author": {
    "name": "Juck",
    "email": "juckz@foxmail.com"
  },
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development EXTENSION=chromium ONEWEB_EXTENSION_DIR=artifacts/dev/chromium run-s clear dev:start",
    "dev-firefox": "cross-env NODE_ENV=development EXTENSION=firefox ONEWEB_EXTENSION_DIR=artifacts/dev/firefox PORT=3304 run-s clear dev:start",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "pnpm run build:background",
    "dev:devtools": "pnpm run build:devtools",
    "dev:devtools-page": "pnpm run build:devtools-page",
    "dev:web": "vite",
    "dev:js": "pnpm run build:js",
    "build": "cross-env NODE_ENV=production run-s build:module-sdk clear build:web build:prepare build:background build:js verify:identity",
    "build:module-sdk": "pnpm --dir packages/module-sdk build",
    "build:firefox": "cross-env EXTENSION=firefox ONEWEB_EXTENSION_DIR=artifacts/build/firefox pnpm run build",
    "build:prepare": "esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "build:devtools": "vite build --config vite.config.devtools.ts",
    "build:devtools-page": "vite build --config vite.config.devtools-page.ts",
    "build:web": "vite build",
    "build:js": "run-p build:js:*",
    "build:js:apps": "vite build --config vite.config.apps.ts",
    "build:js:context": "vite build --config vite.config.content.ts",
    "build:js:assistant": "vite build --config vite.config.assistant.ts",
    "build:js:video-dubbing": "vite build --config vite.config.video-dubbing.ts",
    "build:js:page-toolbox": "vite build --config vite.config.page-toolbox.ts",
    "build:js:network-management": "vite build --config vite.config.network-management.ts",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "esno scripts/extension-artifacts.ts pack-zip",
    "pack:crx": "esno scripts/extension-artifacts.ts pack-crx",
    "pack:xpi": "esno scripts/extension-artifacts.ts pack-xpi",
    "start:chromium": "esno scripts/extension-artifacts.ts run-chromium",
    "start:firefox": "esno scripts/extension-artifacts.ts run-firefox",
    "clear": "esno scripts/extension-artifacts.ts clean",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live-llm": "esno scripts/test-live-llm.ts",
    "test:e2e:firefox": "esno scripts/verify-firefox-page-toolbox.ts",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit --pretty",
    "verify": "run-s typecheck lint test:coverage build",
    "verify:chromium": "cross-env EXTENSION=chromium ONEWEB_EXTENSION_DIR=artifacts/test/chromium EXTENSION_PATH=artifacts/test/chromium ONEWEB_TEST_OUTPUT_DIR=artifacts/test-results/chromium REPOLENS_ORIGIN=http://127.0.0.1:14747 REPOLENS_REQUIRE_HTTPS=false run-s build test:e2e:strict",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:ui": "playwright test --ui",
    "manifest:validate": "esno scripts/extension-artifacts.ts lint",
    "verify:identity": "esno scripts/verify-pre-release-identity.ts",
    "verify:firefox": "cross-env EXTENSION=firefox ONEWEB_EXTENSION_DIR=artifacts/test/firefox EXTENSION_PATH=artifacts/test/firefox run-s build manifest:validate test:e2e:firefox",
    "verify:module-sdk": "pnpm --dir packages/module-sdk verify",
    "dev:start": "run-p dev:prepare dev:background dev:devtools dev:devtools-page dev:web dev:js",
    "dev:test": "run-p dev test:watch",
    "build:chromium": "cross-env EXTENSION=chromium ONEWEB_EXTENSION_DIR=artifacts/build/chromium pnpm run build",
    "build:all": "run-s build:chromium build:firefox build:userscript",
    "test:e2e:strict": "playwright test --retries=0",
    "build:userscript": "vite build --config vite.config.userscript.ts",
    "test:e2e:userscript": "playwright test --config playwright.userscript.config.ts",
    "verify:userscript": "run-s build:userscript test:e2e:userscript",
    "verify:firefox:toolbox": "cross-env FIREFOX_SCENARIO=toolbox pnpm run verify:firefox",
    "release:prepare": "run-s build:all && esno scripts/release-artifacts.ts prepare",
    "release:rehearse": "run-s build:all && esno scripts/release-artifacts.ts prepare --local",
    "release:verify": "esno scripts/release-artifacts.ts verify",
    "test:release": "vitest run src/utils/__tests__/release-artifacts.test.ts src/utils/__tests__/verify-pre-release-identity.test.ts src/utils/__tests__/userscript-manager-runner.test.ts && python3 -B -m unittest discover -s scripts/tests -v",
    "test:userscript:manager": "pnpm build:userscript && node scripts/test-userscript-manager.cjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": "eslint --fix",
    "*.{css,less,html,md}": "eslint --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.4",
    "element-plus": "^2.8.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@ffflorian/jszip-cli": "^3.7.1",
    "@iconify/json": "^2.2.239",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.0.239",
    "@types/file-saver": "^2.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/webextension-polyfill": "0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@unocss/eslint-plugin": "^0.62.4",
    "@unocss/reset": "^0.62.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/coverage-v8": "^2.0.5",
    "@vue/compiler-sfc": "^3.4.38",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^11.0.1",
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-format": "^0.1.2",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.1",
    "kolorist": "^1.8.0",
    "less": "^4.1.3",
    "lint-staged": "^15.2.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.5.4",
    "unocss": "^0.62.4",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-icons": "^0.19.2",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.9",
    "vitest": "^2.0.5",
    "vue": "^3.4.38",
    "vue-demi": "^0.14.10",
    "web-ext": "10.6.0"
  },
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.12.0"
  }
}
