{
  "name": "one-web",
  "displayName": "OneWeb",
  "version": "0.1.0",
  "private": true,
  "description": "你的浏览器伴侣：把搜索、整理、浏览器工具与智能分析集中到一个侧边工作台。",
  "homepage": "https://github.com/JuckZ/one-web",
  "author": {
    "name": "Juck",
    "email": "juckz@foxmail.com"
  },
  "type": "module",
  "scripts": {
    "dev": "cross-env EXTENSION=chromium ONEWEB_EXTENSION_DIR=artifacts/dev/chromium wxt -b chrome",
    "dev-firefox": "cross-env EXTENSION=firefox ONEWEB_EXTENSION_DIR=artifacts/dev/firefox PORT=3304 wxt -b firefox --mv3",
    "build": "cross-env NODE_ENV=production run-s build:module-sdk build:extension verify:identity",
    "build:module-sdk": "pnpm --dir packages/module-sdk build",
    "build:firefox": "cross-env EXTENSION=firefox ONEWEB_EXTENSION_DIR=artifacts/build/firefox pnpm run build",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "esno scripts/extension-artifacts.ts pack-zip",
    "pack:crx": "esno scripts/extension-artifacts.ts pack-crx",
    "pack:xpi": "esno scripts/extension-artifacts.ts pack-xpi",
    "start:chromium": "esno scripts/extension-artifacts.ts run-chromium",
    "start:firefox": "esno scripts/extension-artifacts.ts run-firefox",
    "clear": "esno scripts/extension-artifacts.ts clean",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live-llm": "esno scripts/test-live-llm.ts",
    "test:e2e:firefox": "esno scripts/verify-firefox-page-toolbox.ts",
    "postinstall": "simple-git-hooks",
    "typecheck": "wxt prepare && tsc --noEmit --pretty",
    "verify": "run-s typecheck lint test:coverage build",
    "verify:chromium": "cross-env EXTENSION=chromium ONEWEB_EXTENSION_DIR=artifacts/test/chromium EXTENSION_PATH=artifacts/test/chromium ONEWEB_TEST_OUTPUT_DIR=artifacts/test-results/chromium REPOLENS_ORIGIN=http://127.0.0.1:14747 REPOLENS_REQUIRE_HTTPS=false run-s build test:e2e:strict",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:ui": "playwright test --ui",
    "manifest:validate": "esno scripts/extension-artifacts.ts lint",
    "verify:identity": "esno scripts/verify-pre-release-identity.ts",
    "verify:firefox": "cross-env EXTENSION=firefox ONEWEB_EXTENSION_DIR=artifacts/test/firefox EXTENSION_PATH=artifacts/test/firefox run-s build manifest:validate test:e2e:firefox",
    "verify:module-sdk": "pnpm --dir packages/module-sdk verify",
    "dev:test": "run-p dev test:watch",
    "build:chromium": "cross-env EXTENSION=chromium ONEWEB_EXTENSION_DIR=artifacts/build/chromium pnpm run build",
    "build:all": "run-s build:chromium build:firefox build:userscript",
    "test:e2e:strict": "playwright test --retries=0",
    "build:userscript": "vite build --config vite.config.userscript.ts",
    "test:e2e:userscript": "playwright test --config playwright.userscript.config.ts",
    "verify:userscript": "run-s build:userscript test:e2e:userscript",
    "verify:firefox:toolbox": "cross-env FIREFOX_SCENARIO=toolbox pnpm run verify:firefox",
    "release:prepare": "run-s build:all && esno scripts/release-artifacts.ts prepare",
    "release:rehearse": "run-s build:all && esno scripts/release-artifacts.ts prepare --local",
    "release:verify": "esno scripts/release-artifacts.ts verify",
    "test:release": "vitest run src/utils/__tests__/release-artifacts.test.ts src/utils/__tests__/verify-pre-release-identity.test.ts src/utils/__tests__/userscript-manager-runner.test.ts && node scripts/test-python.mjs",
    "test:userscript:manager": "pnpm build:userscript && node scripts/test-userscript-manager.cjs",
    "build:extension": "esno scripts/build-extension.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{css,less,html,md}": "eslint --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.4",
    "loglevel": "^1.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.0.239",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/webextension-polyfill": "0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^7.0.3",
    "cross-spawn": "^7.0.6",
    "crx": "^5.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.1",
    "jszip": "^3.10.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.2.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4",
    "web-ext": "10.6.0",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.12.0"
  }
}
