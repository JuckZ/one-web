{
  "version": 1,
  "lock_timeout_seconds": 1800,
  "checks": [
    {
      "name": "factory-self-tests",
      "argv": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/agent-factory/tests",
        "-v"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "typecheck",
      "argv": [
        "pnpm",
        "run",
        "typecheck"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "lint",
      "argv": [
        "pnpm",
        "run",
        "lint"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "unit-tests-with-coverage",
      "argv": [
        "pnpm",
        "run",
        "test:coverage"
      ],
      "timeout_seconds": 900
    }
  ]
}
